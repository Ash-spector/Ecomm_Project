@model IEnumerable<Ecomm_Project.Models.Product>

<!-- Search Bar & Radio Buttons -->
<div class="row mb-4">
    <div class="col-md-8 offset-md-2">

        <div class="input-group">
            <select id="searchFilter" class="form-select" style="max-width:140px;">
                <option value="all">All</option>
                <option value="title">Books</option>
                <option value="author">Authors</option>
            </select>

            <!-- 🔍 Search Input -->
            <input type="text"
                   id="searchInput"
                   class="form-control"
                   placeholder="Search books..." />
            <button class="btn btn-primary" onclick="searchBooks()">
               <i class=" fas fa-search"></i>
            </button>

        </div>

    </div>
</div>
<!-- 🔥 No Result Message -->
<div id="noResultMessage" class="text-center text-danger mb-3" style="display:none;">
    <h5>No books found</h5>
</div>
<!-- Book Cards -->
<div class="row" id="bookContainer">
    @foreach (var product in Model)
    {
        <div class="col-lg-3 col-md-6 book-card"
             data-title="@product.Title.ToLower()"
             data-author="@product.Author.ToLower()">

            <div class="row p-2">
                <div class="col-12 p-1" style="border:1px solid #008cba; border-radius: 5px;">
                    <div class="card" style="border:0px;">

                        @if (product.ImageUrl != null)
                        {
                            <img src="@product.ImageUrl" class="card-img-top rounded" />
                        }

                        <div class="pl-1">
                            <p class="card-title h5">
                                <b style="color:#2c3e50">@product.Title</b>
                            </p>
                            <p class="card-title text-primary">
                                by <b>@product.Author</b>
                            </p>
                        </div>

                        <div style="padding-left:5px;">
                            <p>
                                List Price:
                                <strike><b>$@product.ListPrice.ToString("0.00")</b></strike>
                            </p>
                        </div>

                        <div style="padding-left:5px;">
                            <p style="color:maroon">
                                As low as:
                                <b>$@product.Price100.ToString("0.00")</b>
                            </p>
                        </div>

                    </div>

                    <div>
                        <a asp-action="Details"
                               class="btn btn-primary form-control"
                               asp-route-id="@product.Id">
                            Details
                        </a>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/home.js"></script>
}